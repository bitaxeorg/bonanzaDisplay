(version 1)

(rule "JLCPCB component PTH hole to copper"
	# JLCPCB multilayer 1 oz copper, routed outline; capabilities checked 2026-10-14.
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm))
	(severity error)
)

(rule "JLCPCB inner component PTH hole to copper"
	# JLCPCB multilayer 1 oz copper, routed outline; capabilities checked 2026-10-14.
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(layer inner)
	(constraint hole_clearance (min 0.3mm))
	(severity error)
)

(rule "JLCPCB component hole to hole"
	# JLCPCB multilayer 1 oz copper, routed outline; capabilities checked 2026-10-14.
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Hole_Size_X > 0mm && B.Hole_Size_X > 0mm")
	(constraint hole_to_hole (min 0.45mm))
	(severity error)
)

(rule "JLCPCB component PTH annular ring"
	# JLCPCB multilayer 1 oz copper, routed outline; capabilities checked 2026-10-14.
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm))
	(severity error)
)

(rule "JLCPCB SMD pad to pad"
	# JLCPCB multilayer 1 oz copper, routed outline; capabilities checked 2026-10-14.
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net")
	(constraint clearance (min 0.15mm))
	(severity error)
)

(rule "JLCPCB NPTH round minimum drill"
	# JLCPCB multilayer 1 oz copper, routed outline; capabilities checked 2026-10-14.
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X == A.Hole_Size_Y")
	(constraint hole_size (min 0.5mm))
	(severity error)
)

(rule "JLCPCB NPTH slot minimum width"
	# JLCPCB multilayer 1 oz copper, routed outline; capabilities checked 2026-10-14.
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X != A.Hole_Size_Y")
	(constraint hole_size (min 1mm))
	(severity error)
)

(rule "JLCPCB plated slot minimum width"
	# JLCPCB multilayer 1 oz copper, routed outline; capabilities checked 2026-10-14.
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y")
	(constraint hole_size (min 0.35mm))
	(severity error)
)
